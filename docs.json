{
  "$schema": "https://mintlify.com/docs.json",
  "name": "AgentNode",
  "theme": "luma",
  "colors": {
    "primary": "#4f46e5",
    "light": "#a49cf4",
    "dark": "#0c142c"
  },
  "logo": {
    "light": "/logo.svg",
    "dark": "/logo-dark.svg"
  },
  "favicon": "/favicon.svg",
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Get started",
      "href": "https://goagentnode.com/signup"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "quickstart",
              "account-setup"
            ]
          },
          {
            "group": "The App",
            "pages": [
              "operator",
              "inbox",
              "contacts",
              "assistants",
              "iphone-app",
              "texting-agentnode"
            ]
          },
          {
            "group": "AI & Messaging",
            "pages": [
              "learning",
              "ai-messaging",
              "guardrails",
              "opt-outs"
            ]
          },
          {
            "group": "Settings & Compliance",
            "pages": [
              "settings",
              "messaging-compliance",
              "privacy-and-terms"
            ]
          },
          {
            "group": "Help",
            "pages": [
              "support",
              "glossary"
            ]
          }
        ]
      }
    ]
  },
  "fonts": {
    "heading": {
      "family": "Space Grotesk"
    },
    "body": {
      "family": "DM Sans"
    }
  },
  "seo": {
    "organization": {
      "id": "https://goagentnode.com/#organization",
      "name": "AgentNode",
      "legalName": "Whiteworth Inc.",
      "url": "https://goagentnode.com",
      "logo": "https://goagentnode.com/brand/apple-touch-icon.png"
    }
  },
  "redirects": [
    {
      "source": "/campaigns",
      "destination": "/assistants"
    },
    {
      "source": "/weave",
      "destination": "/ai-messaging"
    }
  ]
}
